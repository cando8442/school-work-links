rules_version = '2';

/* ===================================================================
   다른 학교로 옮길 때 여기 두 곳만 고치세요.
     1) schoolAccount() 안의 도메인   예: '.*@abc[.]sen[.]hs[.]kr$'   (점은 [.] 로)
     2) isOwner() 안의 관리자 주소     예: 'teacher@abc.sen.hs.kr'
   src/config/school.ts 의 domain, ownerEmail 과 같아야 합니다.
   =================================================================== */

/* 부별공유 보안 규칙입니다.

   학교 구글 계정으로 로그인한 사람만 읽고 쓸 수 있습니다.
   - duties : 부서별 업무 기록. 쓴 사람만 고치거나 지울 수 있습니다.
   - tasks  : 제출 과제. 만든 사람만 고치거나 지울 수 있고,
              제출 완료 표시(done)는 로그인한 학교 계정이면 누구나 바꿀 수 있습니다.

   도메인을 바꾸려면 아래 schoolAccount() 안의 주소를 고치세요. */
service cloud.firestore {
  match /databases/{database}/documents {

    function schoolAccount() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@seoulsejong[.]sen[.]hs[.]kr$');
    }

    /* 편집 권한을 가진 사람입니다. admins 모음에 이메일로 등록되어 있어야 합니다. */
    function isOwner() {
      return schoolAccount() && request.auth.token.email == 'cando8442@seoulsejong.sen.hs.kr';
    }

    function adminData() {
      return get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data;
    }

    function isEditor() {
      return schoolAccount()
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    /* 담당 부서가 비어 있으면 모든 부서를, 정해져 있으면 그 부서만 고칠 수 있습니다. */
    function canEditDept(deptId) {
      return isOwner() || (isEditor() && (adminData().dept == '' || adminData().dept == deptId));
    }

    function isAuthor() {
      return schoolAccount() && resource.data.authorEmail == request.auth.token.email;
    }

    match /duties/{dutyId} {
      allow read: if schoolAccount();

      allow create: if canEditDept(request.resource.data.deptId)
        && request.resource.data.authorEmail == request.auth.token.email
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 60
        && request.resource.data.deptId is string
        && request.resource.data.routines.size() <= 10
        && request.resource.data.links.size() <= 10;

      allow update: if isAuthor() && canEditDept(resource.data.deptId)
        && request.resource.data.authorEmail == resource.data.authorEmail;

      allow delete: if isAuthor() && canEditDept(resource.data.deptId);
    }

    match /tasks/{taskId} {
      allow read: if schoolAccount();

      allow create: if schoolAccount()
        && request.resource.data.authorEmail == request.auth.token.email
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 60
        && request.resource.data.due is string
        && request.resource.data.targets.size() <= 60
        && request.resource.data.done.size() == 0;

      /* 제출 완료 표시만 바꾸는 경우는 학교 계정이면 누구나 할 수 있습니다. */
      allow update: if schoolAccount()
        && (
          isAuthor()
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done'])
              && request.resource.data.done.size() <= 60)
        );

      allow delete: if isAuthor();
    }

    match /depts/{deptId} {
      allow read: if schoolAccount();
      allow write: if canEditDept(deptId)
        && request.resource.data.keys().hasOnly(['driveUrl', 'updatedBy'])
        && request.resource.data.updatedBy == request.auth.token.email;
    }

    match /posts/{postId} {
      allow read: if schoolAccount();
      allow create: if schoolAccount()
        && request.resource.data.authorEmail == request.auth.token.email
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 60
        && request.resource.data.body.size() <= 4000;
      allow update: if isAuthor();
      allow delete: if isAuthor();
    }

    match /forms/{formId} {
      allow read: if schoolAccount();
      allow create: if canEditDept(request.resource.data.deptId)
        && request.resource.data.authorEmail == request.auth.token.email
        && request.resource.data.label is string
        && request.resource.data.label.size() >= 1
        && request.resource.data.label.size() <= 40
        && request.resource.data.href is string;
      allow update, delete: if isAuthor() && canEditDept(resource.data.deptId);
    }

    /* 학사일정과 마감입니다. 권한자만 넣고 지울 수 있습니다. */
    match /events/{eventId} {
      allow read: if schoolAccount();
      allow create: if (isOwner() || isEditor())
        && request.resource.data.authorEmail == request.auth.token.email
        && request.resource.data.date is string
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 60;
      allow update, delete: if isOwner() || isEditor();
    }

    /* 편집 권한 명단입니다. 문서 아이디가 학교 계정 주소입니다.
       읽기는 로그인한 학교 계정이면 되고, 주고 빼는 것은 최초 관리자만 합니다. */
    match /admins/{adminEmail} {
      allow read: if schoolAccount();
      allow write: if isOwner()
        && (request.method == 'delete'
            || (request.resource.data.keys().hasOnly(['name', 'dept'])
                && request.resource.data.name is string
                && request.resource.data.dept is string));
    }

    /* 그 밖의 모든 경로는 차단합니다. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
